    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst body = src.body || src;\nconst gender = (body.gender || '').toString().toLowerCase().trim();\nif (gender !== 'boy' && gender !== 'girl') {\n  throw new Error('Invalid gender. Expected \"boy\" or \"girl\".');\n}\nreturn [{ json: { gender, ts: new Date().toISOString() } }];\n"
      },
