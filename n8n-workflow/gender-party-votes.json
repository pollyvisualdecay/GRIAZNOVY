    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet boy = 0, girl = 0;\nitems.forEach(it => {\n  const g = (it.json.gender || '').toString().toLowerCase().trim();\n  if (g === 'boy') boy++;\n  else if (g === 'girl') girl++;\n});\nreturn [{ json: { boy, girl } }];\n"
      },
